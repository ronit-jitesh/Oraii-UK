# ─────────────────────────────────────────────────────────────
# ORAII UK — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local in BOTH apps/clinic AND apps/patient
# and fill in the values. Production deployments MUST set every
# variable explicitly — defaults below are illustrative only.
#
# UK-GDPR / DCB0129: every cloud processor handling PHI MUST be
# pinned to a UK or EU regional endpoint. Defaults that route via
# the US are a compliance violation. The runtime validator in
# packages/core/src/env.ts will refuse to start if an endpoint
# does not match a known UK/EU pattern.
# ─────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────────────────────────
# Project must be created in eu-west-2 (London) or another EU region.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── OpenAI ───────────────────────────────────────────────────
# Production: use OpenAI Enterprise with EU data residency
# (OPENAI_BASE_URL=https://eu.api.openai.com/v1) OR migrate to
# Azure OpenAI in UK South region (OPENAI_BASE_URL=
# https://<resource>.openai.azure.com/openai/deployments/<deployment>).
# Local dev only: leave OPENAI_BASE_URL unset to use SDK default.
OPENAI_API_KEY=sk-proj-your-key
OPENAI_ORG_ID=your-org-id
OPENAI_BASE_URL=

# ── Deepgram ─────────────────────────────────────────────────
# MUST be the EU endpoint. The transcribe route validates this
# and refuses non-EU URLs at request time.
DEEPGRAM_API_KEY=your-deepgram-key
DEEPGRAM_ENDPOINT=https://api.eu.deepgram.com

# ── Public app URLs ──────────────────────────────────────────
NEXT_PUBLIC_CLINIC_URL=http://localhost:3000
NEXT_PUBLIC_PATIENT_URL=http://localhost:3001

# ─────────────────────────────────────────────────────────────
# Removed (deliberate):
#   GROQ_API_KEY        — no UK DPA, US-hosted, removed from chat fallback
#   SARVAM_API_KEY      — Indian-language API, not used in UK build
#   GOOGLE_CLOUD_PROJECT — multilingual STT not used in UK build
# Re-introduce only with a signed UK/EU DPA + region pin.
# ─────────────────────────────────────────────────────────────
